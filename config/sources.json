{
  "schema_version": 2,
  "timezone": "Asia/Shanghai",
  "policy": {
    "news_window_hours": 24,
    "discovery_window_days": 7,
    "max_items": 10,
    "allow_empty": true,
    "editorial_review_required": true,
    "publish_automatically": false,
    "selection_goal": "平衡覆盖模型与产品、开源项目、研究和行业动态，不设硬性配额；仅选有实质价值的新变化。",
    "ranking_order": [
      "实质影响与用户用途",
      "事件新鲜度",
      "原始证据与可核查性",
      "跨来源佐证"
    ],
    "date_rules": [
      "新闻与官方发布优先过去24小时，事件日期与报道日期分别核对。",
      "研究与项目发现可回看7天，明确标注原始发布日期、版本或更新时间；较早背景不冒充今日新闻。",
      "HTML列表、热榜抓取时间、模型卡lastModified和仓库星数不证明首次发布日期。",
      "缺少可信日期的线索进入待核实队列，不直接发布。"
    ],
    "evidence_rules": [
      "优先官方公告、版本记录、论文与模型卡，新闻汇总用于发现。",
      "GitHub stars、Trending热度、论文点赞和模型下载量仅供发现，不作质量排名。",
      "预印本明确标注未经同行评审；评测注明基准、版本、时间及限制。",
      "合并同一事件的重复报道；项目补充具体用途、重要变化和许可证线索。",
      "无重要新增时允许0条；可访问不等于适合刊发。"
    ],
    "coverage_topics": [
      "模型与产品",
      "Agent",
      "编程工具",
      "推理与服务",
      "RAG与检索",
      "多模态",
      "本地部署",
      "开发基础设施",
      "研究",
      "产业与政策"
    ],
    "fetch_limits": {
      "workers": 6,
      "timeout_seconds": 18,
      "max_bytes_per_source": 4000000,
      "github_releases_per_repo": 5,
      "hf_items_per_source": 20
    },
    "html_sources_are_discovery_only": true
  },
